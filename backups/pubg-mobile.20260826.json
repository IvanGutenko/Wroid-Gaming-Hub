{
  "schema_version": 2,
  "name": "PUBG Mobile — default landscape HUD",
  "package_name": "com.tencent.ig",
  "orientation": "landscape",
  "bindings": [
    {
      "name": "movement",
      "input": {
        "kind": "key_cluster",
        "up": "w",
        "left": "a",
        "down": "s",
        "right": "d"
      },
      "action": {
        "kind": "virtual_joystick",
        "center": {
          "x": 0.16,
          "y": 0.77
        },
        "radius": 0.105,
        "dead_zone": 0.02,
        "mode": "hold",
        "reaffirm_ms": 50,
        "slow_key": "shift",
        "slow_scale": 0.45,
        "slow_mode": "toggle"
      }
    },
    {
      "name": "camera",
      "input": {
        "kind": "mouse_move"
      },
      "action": {
        "kind": "mouse_aim",
        "region": {
          "x": 0.4,
          "y": 0.1,
          "w": 0.37,
          "h": 0.8
        },
        "sensitivity": 1.15,
        "toggle_key": "tab",
        "recenter_threshold": 1.0,
        "recenter_gap_ms": 0,
        "ads_multiplier": 0.62,
        "reaffirm_ms": 250
      }
    },
    {
      "name": "fire",
      "input": {
        "kind": "mouse_button",
        "button": "left"
      },
      "action": {
        "kind": "hold",
        "point": {
          "x": 0.91,
          "y": 0.48
        }
      }
    },
    {
      "name": "aim_down_sights",
