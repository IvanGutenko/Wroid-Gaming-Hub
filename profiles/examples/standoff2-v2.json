{
  "schema_version": 2,
  "name": "Standoff 2 — default landscape HUD",
  "package_name": "com.axlebolt.standoff2",
  "orientation": "landscape",
  "bindings": [
    {
      "name": "movement",
      "input": {
        "kind": "key_cluster",
        "up": "w",
        "left": "a",
        "down": "s",
        "right": "d"
      },
      "action": {
        "kind": "virtual_joystick",
        "center": {
          "x": 0.16,
          "y": 0.76
        },
        "radius": 0.1,
        "dead_zone": 0.02,
        "mode": "hold",
        "reaffirm_ms": 50
      }
    },
    {
      "name": "camera",
      "input": {
        "kind": "mouse_move"
      },
      "action": {
        "kind": "mouse_aim",
        "region": {
          "x": 0.4,
          "y": 0.1,
          "w": 0.37,
          "h": 0.8
        },
        "sensitivity": 1.15,
        "recenter_threshold": 1.0,
        "recenter_gap_ms": 0,
        "ads_multiplier": 0.62,
        "reaffirm_ms": 250
      }
    },
    {
      "name": "fire",
      "input": {
        "kind": "mouse_button",
        "button": "left"
      },
      "action": {
        "kind": "hold",
        "point": {
          "x": 0.91,
          "y": 0.47
        }
      }
    },
    {
      "name": "aim_down_sights",
      "input": {
        "kind": "mouse_button",
        "button": "right"
      },
      "action": {
        "kind": "tap",
        "point": {
          "x": 0.84,
          "y": 0.39
        }
      }
    },
    {
      "name": "reload",
      "input": {
        "kind": "key",
        "key": "r"
      },
      "action": {
        "kind": "tap",
        "point": {
          "x": 0.88,
          "y": 0.67
        }
      }
    },
    {
      "name": "jump",
      "input": {
        "kind": "key",
        "key": "space"
      },
      "action": {
        "kind": "tap",
        "point": {
          "x": 0.81,
          "y": 0.58
        }
      }
    },
    {
      "name": "crouch",
      "input": {
        "kind": "key",
        "key": "c"
      },
      "action": {
        "kind": "tap",
        "point": {
          "x": 0.76,
          "y": 0.76
        }
      }
    },
    {
      "name": "weapon-1-wheel",
      "input": {
        "kind": "key",
        "key": "1"
      },
      "action": {
        "kind": "radial_select",
        "center": {
          "x": 0.91,
          "y": 0.14
        },
        "distance": 0.07,
        "direction": "left"
      }
    },
    {
      "name": "weapon-2-wheel",
      "input": {
        "kind": "key",
        "key": "2"
      },
      "action": {
        "kind": "radial_select",
        "center": {
          "x": 0.91,
          "y": 0.14
        },
        "distance": 0.07,
        "direction": "down"
      }
    },
    {
      "name": "action",
      "input": {
        "kind": "key",
        "key": "f"
      },
      "action": {
        "kind": "tap",
        "point": {
          "x": 0.6,
          "y": 0.57
        }
      }
    },
    {
      "name": "weapon-3-wheel",
      "input": {
        "kind": "key",
        "key": "3"
      },
      "action": {
        "kind": "radial_select",
        "center": {
          "x": 0.85,
          "y": 0.15
        },
        "distance": 0.07,
        "direction": "left"
      }
    },
    {
      "name": "weapon-4-wheel",
      "input": {
        "kind": "key",
        "key": "4"
      },
      "action": {
        "kind": "radial_select",
        "center": {
          "x": 0.85,
          "y": 0.15
        },
        "distance": 0.07,
        "direction": "down"
      }
    }
  ]
}
